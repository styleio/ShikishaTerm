# 資格情報。実値だけでなく .env.bak / .env~ / .env.local といった派生も一切追跡しない
# (エディタやシェルが同じトークンを持つ写しを勝手に隣に作る)。キー名だけの雛形
# .env.example も、公開しても誰の役にも立たないので非公開側が持つ
.env*
# 利用者の持ち物 (設定と資格情報)
/config/
workspaces/*.json
!workspaces/*.example.json
# 持ち出したワークスペース (接続先や作業フォルダがそのまま入っている)
*.stws.json
projects/
logs/


# Added by cargo

/target

# 状態ファイル置き場 (トークンや既読などの利用者ごとの状態)
/data/

# 開発中の実行フォルダ (Dev.cmd が作る。利用者の設定が入る)
run/

# Microsoft の ConPTY 再頒布物 (tools/conpty.ps1 が取得する)。
# ハッシュは packaging/conpty/redist.json に固定してあるので、リポジトリが
# バイナリを抱える必要はない。vendor/ の他 (vt100) はソースなので追跡する
/vendor/conpty/





#AI
.claude
# 外から入れたスキルの実体。skills-lock.json に出所とハッシュが残るので、
# 中身は追跡しない。入れ直しは npx skills experimental_install
/.agents/

# demo/scratch artifacts (not source)
/demo*.mp4
/demo*.gif
/_*.png
/scratch_*

# 私物ひとまとめ (設定・資格情報・このPC専用の道具・ロゴ原本)。追跡しない
/.private/
/.private.git/

# 起動ランチャは exe と同じ場所にだけ置く (ルートに置くと何も起動しない)
Window.cmd

#デバッグ用
/screenshot

# MSIX build output (target/ is already ignored; this is the unpacked staging)
/packaging/**/*.msix
