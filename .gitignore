# 資格情報。実値だけでなく .env.bak / .env~ / .env.local といった派生も一切追跡しない
# (エディタやシェルが同じトークンを持つ写しを勝手に隣に作る)。キー名だけの雛形
# .env.example も、公開しても誰の役にも立たないので非公開側が持つ
.env*
# 利用者の持ち物 (設定と資格情報)
/config/
workspaces/*.json
!workspaces/*.example.json
# 持ち出したワークスペース (接続先や作業フォルダがそのまま入っている)
*.stws.json
projects/
logs/


# Added by cargo

/target

# 状態ファイル置き場 (トークンや既読などの利用者ごとの状態)
/data/

# 開発中の実行フォルダ (Dev.cmd が作る。利用者の設定が入る)
run/





#AI
.claude

# demo/scratch artifacts (not source)
/demo*.mp4
/demo*.gif
/_*.png
/scratch_*

# 私物ひとまとめ (設定・資格情報・このPC専用の道具・ロゴ原本)。
# GitLab のプライベート側が面倒を見る -- .private.git がその git ディレクトリで、
# 同じ作業フォルダに重ねてある。公開側からはどちらも見えない
/.private/
/.private.git/

# 起動ランチャは exe と同じ場所にだけ置く (ルートに置くと何も起動しない)
Window.cmd

#デバッグ用
/screenshot

# MSIX build output (target/ is already ignored; this is the unpacked staging)
/packaging/**/*.msix
