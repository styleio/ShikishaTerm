{
  "name": "Codex CLI",
  "install_url": "https://github.com/openai/codex",
  "install_on_linux": "npm install -g @openai/codex",
  "signed_in_on_linux": "test -s \"$HOME/.codex/auth.json\" || test -n \"$OPENAI_API_KEY\"",
  "login_on_linux": "codex login --device-auth",
  "command_match": [
    "codex"
  ],
  "script_match": ["node_modules/@openai/codex/"],
  "busy_patterns": [
    "•\\s*Working",
    "esc to interrupt",
    "•\\s*Thinking"
  ],
  "pasted_patterns": ["\\[Pasted Content \\d+ chars\\]"],
  "question_patterns": [
    "Do you trust the contents of this directory",
    "(?s)Would\\s+you\\s+like\\s+to\\s+(run\\s+the\\s+following\\s+command|make\\s+the\\s+following\\s+edits|grant\\s+these\\s+permissions|send\\s+input\\s+to\\s+the\\s+existing\\s+terminal)\\?.*\\n\\s*›\\s*\\d\\.\\s",
    "(?s)(Do\\s+you\\s+want\\s+to\\s+approve\\s+network\\s+access\\s+to\\s+\"|Approve\\s+app\\s+tool\\s+call\\?).*\\n\\s*›\\s*\\d\\.\\s"
  ],
  "title_busy": ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"],
  "silence_ms": 2000,
  "screen_decoration": "[⠀-⣿]",
  "interrupt": ["esc"],
  "helpers": ["codex-code-mode-host.exe"],
  "opened_args": ["-c", "check_for_update_on_startup=false"],
  "skills": "{home}/.agents/skills",
  "resume": {
    "process_flag": "--no-daemon",
    "process_unless": ["--remote"],
    "with_id": [
      "resume",
      "{id}"
    ],
    "newest_here": [
      "resume",
      "--last"
    ],
    "record": {
      "dir": "{home}/.codex/sessions",
      "id": "payload.session_id",
      "cwd": "payload.cwd",
      "turns": true
    },
    "verify": "{home}/.codex/sessions/*/*/*/rollout-*-{id}.jsonl",
    "asks": {
      "role_at": "/payload/role",
      "role": "user",
      "text_at": "/payload/content",
      "parts": ["input_text"]
    },
    "hook": {
      "file": "{home}/.codex/hooks.json",
      "format": "bare",
      "trust": "codex_app_server",
      "events": [
        "SessionStart"
      ],
      "states": {
        "UserPromptSubmit": "BUSY",
        "PermissionRequest": "QUESTION",
        "Stop": "DONE",
        "Interrupt": "WAIT"
      },
      "turn_end": "Stop",
      "turn_start": "UserPromptSubmit",
      "asks": {
        "PreToolUse": "request_user_input_async"
      }
    }
  }
}
