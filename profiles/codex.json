{
  "name": "Codex CLI",
  "install_url": "https://github.com/openai/codex",
  "command_match": [
    "codex"
  ],
  "script_match": ["node_modules/@openai/codex/"],
  "busy_patterns": [
    "•\\s*Working",
    "esc to interrupt",
    "•\\s*Thinking"
  ],
  "question_patterns": [
    "Do you trust the contents of this directory",
    "Allow command\\?",
    "\\[y/N\\]",
    "\\(y/n\\)",
    "approve",
    "❯\\s*[Yy]es"
  ],
  "title_busy": ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"],
  "silence_ms": 2000,
  "interrupt": ["esc"],
  "resume": {
    "with_id": [
      "resume",
      "{id}"
    ],
    "newest_here": [
      "resume",
      "--last"
    ],
    "record": {
      "dir": "{home}/.codex/sessions",
      "id": "payload.session_id",
      "cwd": "payload.cwd"
    },
    "verify": "{home}/.codex/sessions/*/*/*/rollout-*-{id}.jsonl",
    "asks": {
      "role_at": "/payload/role",
      "role": "user",
      "text_at": "/payload/content",
      "parts": ["input_text"]
    },
    "hook": {
      "file": "{home}/.codex/hooks.json",
      "format": "bare",
      "events": [
        "SessionStart"
      ],
      "states": {
        "UserPromptSubmit": "BUSY",
        "PermissionRequest": "QUESTION",
        "Stop": "DONE",
        "Interrupt": "WAIT"
      }
    }
  }
}
