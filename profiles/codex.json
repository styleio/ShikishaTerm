{
  "name": "Codex CLI",
  "command_match": [
    "codex"
  ],
  "busy_patterns": [
    "•\\s*Working",
    "esc to interrupt",
    "•\\s*Thinking"
  ],
  "question_patterns": [
    "Do you trust the contents of this directory",
    "Allow command\\?",
    "\\[y/N\\]",
    "\\(y/n\\)",
    "approve",
    "❯\\s*[Yy]es"
  ],
  "silence_ms": 2000,
  "resume": {
    "with_id": [
      "resume",
      "{id}"
    ],
    "newest_here": [
      "resume",
      "--last"
    ],
    "record": {
      "dir": "{home}/.codex/sessions",
      "id": "payload.session_id",
      "cwd": "payload.cwd"
    },
    "verify": "{home}/.codex/sessions/*/*/*/rollout-*-{id}.jsonl",
    "hook": {
      "file": "{home}/.codex/hooks.json",
      "format": "bare",
      "events": [
        "SessionStart"
      ],
      "states": {
        "UserPromptSubmit": "BUSY",
        "PermissionRequest": "QUESTION",
        "Stop": "DONE",
        "Interrupt": "WAIT"
      }
    }
  }
}
