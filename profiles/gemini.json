{
  "name": "Gemini CLI",
  "install_url": "https://github.com/google-gemini/gemini-cli",
  "install_on_linux": "npm install -g @google/gemini-cli",
  "command_match": [
    "gemini"
  ],
  "script_match": ["node_modules/@google/gemini-cli/"],
  "busy_patterns": [
    "esc to cancel",
    "[Ww]aiting"
  ],
  "question_patterns": [
    "Apply this change\\?",
    "Allow execution",
    "\\(y/n\\)",
    "●\\s*1\\.",
    "❯\\s*1\\."
  ],
  "title_busy": [
    "✦"
  ],
  "silence_ms": 2000,
  "interrupt": [
    "esc"
  ],
  "resume": {
    "new_id": [
      "--session-id",
      "{id}"
    ],
    "newest_here": [
      "--resume",
      "latest"
    ],
    "hook": {
      "file": "{home}/.gemini/settings.json",
      "format": "bare",
      "timeout_unit": "milliseconds",
      "events": [
        "BeforeAgent"
      ],
      "states": {
        "BeforeAgent": "BUSY",
        "AfterAgent": "DONE"
      }
    }
  }
}
