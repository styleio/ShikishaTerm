{
  "name": "Gemini CLI",
  "command_match": [
    "gemini"
  ],
  "busy_patterns": [
    "esc to cancel",
    "[Ww]aiting"
  ],
  "question_patterns": [
    "Apply this change\\?",
    "Allow execution",
    "\\(y/n\\)",
    "●\\s*1\\.",
    "❯\\s*1\\."
  ],
  "title_busy": ["✦"],
  "silence_ms": 2000,
  "resume": {
    "new_id": [
      "--session-id",
      "{id}"
    ],
    "newest_here": [
      "--resume",
      "latest"
    ]
  }
}
