{
  "name": "Claude Code",
  "install_url": "https://github.com/anthropics/claude-code",
  "install_on_linux": "curl -fsSL https://claude.ai/install.sh | bash",
  "signed_in_on_linux": "test -s \"$HOME/.claude/.credentials.json\" || test -n \"$ANTHROPIC_API_KEY\"",
  "command_match": [
    "claude"
  ],
  "title_match": ["Claude Code"],
  "one_shot": ["-p", "--print"],
  "busy_patterns": [
    "esc to interrupt",
    "ctrl\\+c to stop"
  ],
  "question_patterns": [
    "Do you want to",
    "❯\\s*1\\.",
    "\\(y/n\\)",
    "yes/no",
    "Allow .+\\?",
    "Enter to confirm"
  ],
  "limit_patterns": [
    "You've hit your limit",
    "Usage limit (reached|approaching)",
    "reached your weekly usage limit",
    "until your limit resets at"
  ],
  "title_busy": [
    "◐",
    "◑"
  ],
  "silence_ms": 2000,
  "interrupt": ["esc"],
  "resume": {
    "new_id": [
      "--session-id",
      "{id}"
    ],
    "with_id": [
      "--resume",
      "{id}"
    ],
    "newest_here": [
      "--continue"
    ],
    "hook": {
      "file": "{home}/.claude/settings.json",
      "format": "args",
      "events": [
        "SessionStart"
      ],
      "states": {
        "UserPromptSubmit": "BUSY",
        "PermissionRequest": "QUESTION",
        "Elicitation": "QUESTION",
        "Stop": "DONE",
        "StopFailure": "FAILED"
      }
    },
    "verify": "{home}/.claude/projects/*/{id}.jsonl",
    "asks": {
      "role_at": "/message/role",
      "role": "user",
      "text_at": "/message/content",
      "skip_when": ["/isMeta", "/isCompactSummary"]
    }
  }
}
