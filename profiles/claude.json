{
  "name": "Claude Code",
  "command_match": [
    "claude"
  ],
  "busy_patterns": [
    "esc to interrupt",
    "ctrl\\+c to stop"
  ],
  "question_patterns": [
    "Do you want to",
    "❯\\s*1\\.",
    "\\(y/n\\)",
    "yes/no",
    "Allow .+\\?"
  ],
  "limit_patterns": [
    "You've hit your limit",
    "Usage limit (reached|approaching)",
    "reached your weekly usage limit",
    "until your limit resets at"
  ],
  "title_busy": [
    "◐",
    "◑"
  ],
  "silence_ms": 2000,
  "interrupt": ["esc"],
  "resume": {
    "new_id": [
      "--session-id",
      "{id}"
    ],
    "with_id": [
      "--resume",
      "{id}"
    ],
    "newest_here": [
      "--continue"
    ],
    "hook": {
      "file": "{home}/.claude/settings.json",
      "format": "args",
      "events": [
        "SessionStart"
      ],
      "states": {
        "UserPromptSubmit": "BUSY",
        "PermissionRequest": "QUESTION",
        "Stop": "DONE"
      }
    },
    "verify": "{home}/.claude/projects/*/{id}.jsonl"
  }
}
