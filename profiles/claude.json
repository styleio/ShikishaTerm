{
  "name": "Claude Code",
  "command_match": [
    "claude"
  ],
  "busy_patterns": [
    "esc to interrupt",
    "ctrl\\+c to stop"
  ],
  "question_patterns": [
    "Do you want to",
    "❯\\s*1\\.",
    "\\(y/n\\)",
    "yes/no",
    "Allow .+\\?"
  ],
  "silence_ms": 2000,
  "resume": {
    "new_id": [
      "--session-id",
      "{id}"
    ],
    "with_id": [
      "--resume",
      "{id}"
    ],
    "newest_here": [
      "--continue"
    ],
    "hook": {
      "file": "{home}/.claude/settings.json",
      "format": "args",
      "events": [
        "SessionStart"
      ]
    }
  }
}
