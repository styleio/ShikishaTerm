---
import type { LpCopy } from "../../lp/types";

interface Props {
  copy: LpCopy;
}
const { trust } = Astro.props.copy;
const REPO = "https://github.com/styleio/ShikishaTerm";
---

<section class="trust section" id="trust">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{trust.eyebrow}</span>
      <h2>{trust.title}</h2>
    </div>

    <div class="trust-grid">
      {trust.items.map((t) => (
        <div class="nb trust-card">
          <h3>{t.title}</h3>
          <p>{t.body}</p>
          {t.link && (
            <a href={t.link.href} target={t.link.external ? "_blank" : undefined} rel={t.link.external ? "noopener" : undefined}>
              {t.link.label} →
            </a>
          )}
        </div>
      ))}
    </div>

    <div class="nb-lg stars">
      <span class="stars-count" id="stars-count">
        <svg viewBox="0 0 24 24" fill="#ffd966" stroke="#1c1917" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2.8l2.8 5.9 6.4.9-4.6 4.5 1.1 6.4L12 17.5l-5.7 3 1.1-6.4L2.8 9.6l6.4-.9z" />
        </svg>
        <span data-n>—</span>
        <small>{trust.stars.label}</small>
      </span>
      <p class="stars-ask">{trust.stars.ask}</p>
      <p class="stars-why">{trust.stars.why}</p>
      <a class="btn btn-ink" href={REPO} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
        {trust.stars.button}
      </a>
    </div>
  </div>
</section>

<script>
  // The live star count. If GitHub does not answer (rate limit, offline), the
  // pill keeps its dash; the ask still stands on its own.
  const el = document.querySelector<HTMLElement>("#stars-count [data-n]");
  if (el) {
    fetch("https://api.github.com/repos/styleio/ShikishaTerm", { headers: { Accept: "application/vnd.github+json" } })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((j) => {
        if (typeof j.stargazers_count === "number") el.textContent = j.stargazers_count.toLocaleString();
      })
      .catch(() => {});
  }
</script>
