# What gets handed out, and the only place it is written down.
#
# Several things distribute this app — build.rs (beside the dev exe), the
# copiers that stage a test machine, and release.yml (the download) — and
# they used to each carry their own list. They drifted, quietly: the hook was
# copying lang and nothing else, and no one could see it. A payload named here
# reaches every one of them; anything not named here reaches none.
#
# Lines are `dir/pattern`. Blank lines and # comments are ignored.

# --- Read from beside the exe at run time ---------------------------------
# These OVERRIDE what is embedded in the binary, so a stale copy here wins over
# a correct one inside. Every destination must refresh them together or an old
# file silently outranks the new build.
[beside-exe]
# UI wording. English is embedded; everything else is only ever read from here
lang/*.json
# State-detection profiles. Without them every AI is judged GENERIC and the
# per-AI busy/question patterns never fire
profiles/*.json
# The automation manual. Not just for people: the settings screen hands it to an
# AI as the specification when it writes automation, so an old copy here teaches
# it that half the commands do not exist
docs/AUTOMATION*.md

# --- Placed beside the exe itself, with no folder around them --------------
# Same rule as above, except that the folder structure is dropped: these have
# to sit next to the executable, because that is where Windows looks for them.
[beside-exe-flat]
# Microsoft's newer ConPTY. Windows' own is still the older design that parses
# the child's output into a text buffer and re-renders it at us: it drops whole
# sequences, rewrites others, and spends more than twice as long doing it.
# portable-pty loads a conpty.dll found here in preference to the system one
# with no help from our code, so these two files ARE the feature -- lose them
# and the terminal silently gets slower and less correct. conpty.dll starts
# OpenConsole.exe, so neither travels without the other.
# tools/conpty.ps1 fetches them (hash-pinned); vendor/conpty is gitignored.
vendor/conpty/conpty.dll
vendor/conpty/OpenConsole.exe

# --- Carried by the download only -----------------------------------------
# Nothing here is read by the app; it is what makes an unzipped folder usable.
[package]
Settings.cmd
README.md
README.ja.md
LICENSE
# Everything the program is built from, and the terms each of them was given
# under. MIT, BSD and Apache all permit what they permit on the condition that
# their copyright notice travels with the code, so a download without this file
# is a download handed out outside the grant. tools/notices.ps1 writes it and
# CI checks it is current
THIRD-PARTY-NOTICES.txt
SECURITY.md
config.example.json
secrets.example.json
scripts/**
workspaces/**
